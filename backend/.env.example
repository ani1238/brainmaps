# ── Neon Postgres ──────────────────────────────────────────────────────────────
# Get from: https://console.neon.tech → your project → Connection string
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/brainmaps?sslmode=require

# ── AI grading providers ───────────────────────────────────────────────────────
# Grading tries Groq first, then Gemini, then OpenAI.
# Set at least one — whichever has credits.
#
# Groq (primary) — https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.1-flash-lite
#
# OpenAI (fallback) — https://platform.openai.com/api-keys (needs billing enabled)
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.4-mini

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# http://localhost:3000 is always permitted for local development.
# In production add your Vercel / custom domain URL(s).
ALLOWED_ORIGINS=https://your-app.vercel.app
